# ─────────────────────────────────────────────────────────────────────────────
# AutoJuri — Variáveis de produção (Vercel)
#
# Estas variáveis são embutidas no bundle pelo Vite em build time (npm run build).
# VITE_SUPABASE_* são chaves PÚBLICAS — seguras para commitar.
#
# >>> PARA APONTAR O FRONT PRO BACKEND: edite APENAS a linha VITE_API_BASE_URL
#     abaixo com a URL pública do backend (VPS ou HF Spaces) e dê push.
#     O Vercel rebuilda sozinho (CD). Os demais endpoints derivam dessa base
#     automaticamente (Front end/vite-project/src/config/api.js), então é 1 linha só.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (chaves públicas — seguras no frontend) ─────────────────────────
VITE_SUPABASE_URL=https://sszkrvxhlxfrutwywsko.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_N1VpE-77jkMfRfoLncBO2w_fE2EAc6n

# ── Backend público (ÚNICA linha a trocar após o deploy do backend) ──────────
# Precisa terminar em /api. Exemplos por caminho:
#   VPS + Caddy:  https://api.seu-dominio.com/api
#   HF Spaces:    https://SEU-USUARIO-autojuri-backend.hf.space/api
# Enquanto estiver com o placeholder, as chamadas ao backend vão falhar (esperado
# até o backend existir). Só troque a linha de baixo e dê push.
VITE_API_BASE_URL=https://SEU_BACKEND_PUBLICO/api

# ── Performance ───────────────────────────────────────────────────────────────
# Em produção, polling menos frequente para reduzir carga no banco
VITE_DASHBOARD_REFRESH_MS=5000
